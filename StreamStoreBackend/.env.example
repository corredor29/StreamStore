NODE_ENV=development
PORT=3000
APP_TIMEZONE=America/Bogota

# MySQL / MariaDB (XAMPP: root sin password)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=streamStoreDb
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=-05:00

JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=1d

# Clave para cifrar (AES-256-GCM) passwords de cuentas de streaming. NO cambiar después del seed.
AES_SECRET=cambia_esta_clave_aes

# URL pública de esta API: con ella se arma la URL de las imágenes subidas
PUBLIC_URL=http://localhost:3000
# Carpeta donde se guardan las portadas subidas y tamaño máximo por archivo (MB)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=2

CORS_ORIGIN=http://localhost:5173
# URL del frontend para los enlaces de los correos (Renovar, Mis servicios)
CLIENT_URL=http://localhost:5173

# Mailtrap (sandbox). Si MAIL_USER/MAIL_PASS están vacíos, los correos se simulan en el log.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="StreamStore <no-reply@streamstore.test>"

# node-cron: todos los días 8:00 a.m. hora Bogotá
CRON_ENABLED=true
CRON_SCHEDULE=0 8 * * *
