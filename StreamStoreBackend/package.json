{
    "name": "streamstore-backend",
    "version": "1.0.0",
    "private": true,
    "main": "dist/src/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/src/server.js",
        "type-check": "tsc --noEmit",
        "db:reset": "tsx src/database/seed.ts",
        "seed": "tsx src/database/seed.ts"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.12.1",
        "multer": "^2.5.0",
        "mysql2": "^3.24.6",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.3.1",
        "reflect-metadata": "^0.2.2",
        "sequelize": "^6.37.8",
        "sequelize-typescript": "^2.1.6",
        "winston": "^3.19.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "bcrypt@6.0.0": true,
        "esbuild@0.28.2": true
    }
}
